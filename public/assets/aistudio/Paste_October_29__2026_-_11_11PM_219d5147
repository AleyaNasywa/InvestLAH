<!DOCTYPE html>
<html lang="ms">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>InvestLAH ✨ Belajar Labur, Gen Z Style</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&family=Rubik+Mono+One&display=swap" rel="stylesheet">
<style>
:root{
  --cream:#F7F9F6;--ink:#0F172A;--matcha:#10D989;--coral:#FF4766;
  --blue:#BEE3FF;--purple:#DCCBFF;--pink:#FFC9E0;--yellow:#FFF0A3;--mint:#C8F7E1;--peach:#FFD9B8;
  --r:22px;--sh:6px 6px 0 var(--ink);--sh-sm:4px 4px 0 var(--ink);
  --spring:cubic-bezier(.3,1.6,.5,1);
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:'Bricolage Grotesque',system-ui,sans-serif;background:var(--cream);color:var(--ink);overflow-x:hidden;line-height:1.35;-webkit-font-smoothing:antialiased}
button{font:inherit;color:inherit;cursor:pointer}
input{font:inherit;color:inherit}
a{color:inherit}
.mono{font-family:'Rubik Mono One',sans-serif;letter-spacing:-.02em}

/* ---------- background blobs ---------- */
.blob{position:fixed;border-radius:50%;filter:blur(50px);opacity:.6;z-index:0;pointer-events:none;animation:drift 18s ease-in-out infinite alternate}
.b1{width:380px;height:380px;background:var(--pink);top:-120px;right:-90px}
.b2{width:420px;height:420px;background:var(--blue);bottom:-150px;left:160px;animation-delay:-6s}
.b3{width:300px;height:300px;background:var(--purple);top:40%;right:-120px;animation-delay:-11s}
.b4{width:260px;height:260px;background:var(--mint);top:-80px;left:200px;animation-delay:-3s}
@keyframes drift{to{transform:translate(40px,30px) scale(1.12) rotate(20deg)}}

/* ---------- sidebar ---------- */
.side{position:fixed;inset:0 auto 0 0;width:272px;padding:22px 16px;background:#fff;border-right:3px solid var(--ink);z-index:60;display:flex;flex-direction:column;gap:6px;overflow-y:auto;transition:transform .45s var(--spring)}
.logo{display:flex;align-items:center;gap:10px;padding:6px 8px 18px;font-size:26px;font-weight:800}
.logo-badge{width:46px;height:46px;border-radius:14px;background:var(--matcha);border:3px solid var(--ink);box-shadow:var(--sh-sm);display:grid;place-items:center;font-size:24px;animation:wiggle 3s ease-in-out infinite}
.logo b{color:var(--matcha);-webkit-text-stroke:1.5px var(--ink)}
@keyframes wiggle{0%,100%{transform:rotate(-6deg)}50%{transform:rotate(6deg)}}
.nav-item{display:flex;align-items:center;gap:10px;padding:10px 12px;border:3px solid transparent;border-radius:16px;font-weight:700;background:none;text-align:left;width:100%;transition:all .25s var(--spring);position:relative}
.nav-item:hover{border-color:var(--ink);background:var(--yellow);transform:translateX(5px) rotate(-1deg)}
.nav-item.active{background:var(--matcha);border-color:var(--ink);box-shadow:var(--sh-sm)}
.nav-emo{font-size:24px;width:34px;text-align:center;transition:transform .3s var(--spring)}
.nav-item:hover .nav-emo,.nav-item.active .nav-emo{transform:scale(1.25) rotate(-10deg)}
.nav-txt{flex:1;font-size:15px;line-height:1.15}
.nav-txt small{display:block;font-size:11px;opacity:.55;font-weight:800}
.nav-done{font-size:13px;opacity:0;transition:.3s}
.nav-item.visited .nav-done{opacity:1}
.side-foot{margin-top:auto;padding:14px;border:3px dashed var(--ink);border-radius:16px;font-size:12.5px;font-weight:600;background:var(--cream)}
.topbar{display:none}
.scrim{display:none}

main{margin-left:272px;padding:30px 34px 90px;position:relative;z-index:1;min-height:100vh}
.tab{display:none;max-width:1080px;margin:0 auto}
.tab.on{display:block;animation:tabIn .6s var(--spring)}
@keyframes tabIn{from{opacity:0;transform:translateY(30px) scale(.98)}}

/* ---------- primitives ---------- */
.card{background:#fff;border:3px solid var(--ink);border-radius:var(--r);box-shadow:var(--sh);padding:24px;position:relative}
.chip{display:inline-flex;align-items:center;gap:6px;padding:6px 14px;border:2.5px solid var(--ink);border-radius:999px;background:var(--yellow);font-weight:800;font-size:13px;box-shadow:3px 3px 0 var(--ink)}
.chip.pink{background:var(--pink)}.chip.blue{background:var(--blue)}.chip.purple{background:var(--purple)}.chip.mint{background:var(--mint)}.chip.red{background:var(--coral);color:#fff}
.mini{font-size:13px;font-weight:800;text-transform:uppercase;letter-spacing:.06em;opacity:.7}
.h1{font-size:clamp(34px,5.5vw,64px);font-weight:800;line-height:1;letter-spacing:-.03em}
.h2{font-size:clamp(26px,3.6vw,40px);font-weight:800;line-height:1.05;letter-spacing:-.02em}
.h3{font-size:22px;font-weight:800;line-height:1.1}
.lead{font-size:18px;font-weight:600;opacity:.8}
.tiny{font-size:12.5px;opacity:.7;font-weight:600}
.center{text-align:center}
.stack{display:flex;flex-direction:column;gap:18px}
.row{display:flex;gap:12px;flex-wrap:wrap;align-items:center}
.hl{background:var(--matcha);padding:0 .18em;border:3px solid var(--ink);border-radius:14px;box-shadow:var(--sh-sm);display:inline-block;transform:rotate(-2deg)}
.tab-head{text-align:center;margin:6px 0 26px}
.tab-head .h1{margin:14px 0 10px}

.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:13px 22px;border:3px solid var(--ink);border-radius:16px;background:#fff;box-shadow:5px 5px 0 var(--ink);font-weight:800;font-size:16px;transition:transform .18s var(--spring),box-shadow .18s,background .2s;user-select:none;text-decoration:none}
.btn:hover{transform:translate(-3px,-3px) rotate(-1deg);box-shadow:8px 8px 0 var(--ink)}
.btn:active{transform:translate(4px,4px);box-shadow:1px 1px 0 var(--ink)}
.btn.green{background:var(--matcha)}.btn.pink{background:var(--pink)}.btn.blue{background:var(--blue)}.btn.purple{background:var(--purple)}.btn.yellow{background:var(--yellow)}.btn.red{background:var(--coral);color:#fff}
.btn.big{font-size:clamp(18px,2.4vw,24px);padding:18px 30px;border-radius:20px;box-shadow:7px 7px 0 var(--ink)}
.btn.glow{animation:glow 1.8s ease-in-out infinite}
@keyframes glow{0%,100%{filter:drop-shadow(0 0 0 rgba(16,217,137,0))}50%{filter:drop-shadow(0 0 18px rgba(16,217,137,.85))}}
.btn.bouncy{animation:bob 2.2s ease-in-out infinite}
@keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(-7px)}}
.btn.bouncy:hover{animation:none}
.btn[disabled]{opacity:.45;pointer-events:none}
.next-wrap{display:flex;justify-content:center;margin:34px 0 6px}

/* inputs */
.money{display:flex;align-items:center;border:3px solid var(--ink);border-radius:18px;background:#fff;box-shadow:5px 5px 0 var(--ink);overflow:hidden;transition:transform .2s var(--spring),box-shadow .2s}
.money:focus-within{transform:translate(-3px,-3px);box-shadow:8px 8px 0 var(--ink);background:var(--yellow)}
.money span{padding:0 4px 0 16px;font-weight:800;font-size:20px;opacity:.6}
.money input{border:none;outline:none;background:transparent;width:100%;padding:12px 14px 12px 4px;font-size:clamp(24px,3.4vw,34px);font-weight:800;min-width:0}
.money.sm{box-shadow:3px 3px 0 var(--ink);border-radius:12px;width:130px;flex:none}
.money.sm span{font-size:14px;padding-left:10px}
.money.sm input{font-size:18px;padding:7px 8px 7px 2px}
.money.xl input{font-size:clamp(40px,7vw,72px);text-align:center;padding:16px}
.money.xl span{font-size:34px;padding-left:22px}
input[type=number]::-webkit-inner-spin-button{opacity:0}
.txt{width:100%;border:3px solid var(--ink);border-radius:16px;padding:14px 16px;font-size:20px;font-weight:700;box-shadow:5px 5px 0 var(--ink);outline:none;background:#fff}
.txt:focus{background:var(--yellow)}

input[type=range].chunky{-webkit-appearance:none;appearance:none;width:100%;height:22px;border:3px solid var(--ink);border-radius:999px;background:linear-gradient(to right,var(--fill,var(--matcha)) var(--p,50%),#fff var(--p,50%));box-shadow:3px 3px 0 var(--ink);outline:none;cursor:pointer}
input[type=range].chunky::-webkit-slider-thumb{-webkit-appearance:none;width:36px;height:36px;border-radius:50%;background:#fff;border:3px solid var(--ink);box-shadow:3px 3px 0 var(--ink);cursor:grab;transition:transform .2s var(--spring)}
input[type=range].chunky:active::-webkit-slider-thumb{transform:scale(1.25);cursor:grabbing;background:var(--yellow)}
input[type=range].chunky::-moz-range-thumb{width:32px;height:32px;border-radius:50%;background:#fff;border:3px solid var(--ink);box-shadow:3px 3px 0 var(--ink);cursor:grab}
input[type=range].chunky.thin{height:16px}
input[type=range].chunky.thin::-webkit-slider-thumb{width:28px;height:28px}

/* subnav */
.subnav{position:sticky;top:14px;z-index:30;display:flex;gap:6px;padding:7px;background:#fff;border:3px solid var(--ink);border-radius:999px;box-shadow:var(--sh-sm);overflow-x:auto;margin:0 auto 26px;width:fit-content;max-width:100%;scrollbar-width:none}
.subnav::-webkit-scrollbar{display:none}
.subnav button{border-radius:999px;padding:10px 16px;border:2.5px solid transparent;font-weight:800;white-space:nowrap;background:none;font-size:15px;transition:all .25s var(--spring)}
.subnav button:hover{background:var(--yellow);transform:translateY(-2px)}
.subnav button.on{background:var(--purple);border-color:var(--ink);box-shadow:3px 3px 0 var(--ink);transform:rotate(-1.5deg)}
.panel{display:none}
.panel.on{display:block}
.panel.on.from-right{animation:fromR .5s var(--spring)}
.panel.on.from-left{animation:fromL .5s var(--spring)}
@keyframes fromR{from{opacity:0;transform:translateX(60px)}}
@keyframes fromL{from{opacity:0;transform:translateX(-60px)}}

/* switch */
.switch{display:inline-flex;border:3px solid var(--ink);border-radius:999px;background:#fff;box-shadow:var(--sh-sm);padding:5px;position:relative;gap:0}
.switch button{position:relative;z-index:2;border:none;background:none;padding:11px 18px;font-weight:800;border-radius:999px;transition:color .2s;white-space:nowrap}
.switch .knob{position:absolute;z-index:1;top:5px;bottom:5px;border-radius:999px;background:var(--matcha);border:2.5px solid var(--ink);box-shadow:2px 2px 0 var(--ink);transition:left .45s var(--spring),width .45s var(--spring)}

/* fx */
.shake{animation:shake .55s cubic-bezier(.36,.07,.19,.97)}
@keyframes shake{10%,90%{transform:translate(-2px,0) rotate(-.5deg)}20%,80%{transform:translate(5px,0) rotate(.8deg)}30%,50%,70%{transform:translate(-10px,0) rotate(-1deg)}40%,60%{transform:translate(10px,0) rotate(1deg)}}
.popit{animation:popit .5s var(--spring)}
@keyframes popit{0%{transform:scale(1)}40%{transform:scale(1.18) rotate(-3deg)}100%{transform:scale(1)}}
.fx{position:fixed;z-index:9998;pointer-events:none;font-size:30px;animation:floatUp 1.3s ease-out forwards;will-change:transform,opacity}
@keyframes floatUp{0%{transform:translate(-50%,-50%) scale(.4);opacity:0}15%{opacity:1;transform:translate(-50%,-80%) scale(1.2)}100%{transform:translate(calc(-50% + var(--dx,0px)),-260%) scale(.9) rotate(var(--rot,20deg));opacity:0}}
.burst{position:fixed;z-index:9998;pointer-events:none;font-size:34px;animation:burst .9s cubic-bezier(.1,.9,.3,1) forwards}
@keyframes burst{0%{transform:translate(-50%,-50%) scale(.2)}70%{opacity:1}100%{transform:translate(calc(-50% + var(--dx)),calc(-50% + var(--dy))) scale(1.2) rotate(var(--rot));opacity:0}}
#confetti{position:fixed;inset:0;pointer-events:none;z-index:9999;width:100vw;height:100vh}
.grayflash{animation:gray 1.2s ease}
@keyframes gray{0%,100%{filter:none}15%,60%{filter:grayscale(1) contrast(1.2)}}
.toast{position:fixed;left:50%;bottom:28px;z-index:9997;transform:translate(-50%,140%);background:var(--yellow);border:3px solid var(--ink);border-radius:18px;box-shadow:var(--sh-sm);padding:14px 22px;font-weight:800;transition:transform .45s var(--spring);max-width:90vw;text-align:center}
.toast.on{transform:translate(-50%,0)}

/* ================= TAB 1 ================= */
.hero{text-align:center;padding:26px 0 30px;position:relative}
.hero .h1{font-size:clamp(40px,7vw,86px);margin:18px auto 16px;max-width:900px}
.sticker{position:absolute;font-size:58px;animation:bob 3s ease-in-out infinite}
.s1{left:3%;top:30px;transform:rotate(-12deg)}.s2{right:4%;top:110px;animation-delay:-1.4s}
.tm{background:linear-gradient(160deg,#fff 0%,var(--blue) 140%);padding:30px}
.tm-top{display:flex;justify-content:space-between;align-items:flex-start;gap:14px;flex-wrap:wrap;margin-bottom:18px}
.tm-year{font-family:'Rubik Mono One';font-size:clamp(50px,9vw,96px);line-height:1;transition:color .3s}
.tm-badge{font-size:clamp(20px,3vw,28px);font-weight:800;background:var(--matcha);border:3px solid var(--ink);border-radius:18px;padding:12px 18px;box-shadow:var(--sh-sm);transition:background .3s}
.boba-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:clamp(8px,2vw,18px);margin:8px 0 30px}
.boba{font-size:clamp(54px,10vw,104px);text-align:center;background:#fff;border:3px solid var(--ink);border-radius:24px;box-shadow:var(--sh-sm);padding:10px 0;transition:transform .55s var(--spring),opacity .45s,filter .45s,background .3s;animation:bobaIn .6s var(--spring) backwards;animation-delay:calc(var(--d)*60ms);cursor:pointer;line-height:1.1}
.boba:hover{transform:rotate(-8deg) scale(1.06)}
@keyframes bobaIn{from{transform:scale(0) rotate(-30deg)}}
.boba.gone{transform:scale(.55) rotate(25deg);opacity:.18;filter:grayscale(1);background:var(--pink);border-style:dashed}
.ticks{display:flex;justify-content:space-between;margin-top:12px;font-weight:800;font-size:14px}
.ticks button{background:none;border:none;padding:4px;border-radius:8px;opacity:.6;transition:.2s}
.ticks button:hover,.ticks button.on{opacity:1;background:var(--yellow);transform:scale(1.15)}
.tm-info{margin-top:22px;display:grid;gap:6px}
.tm-l1{font-size:clamp(20px,2.8vw,28px);font-weight:800}
.tm-l2{font-size:18px;font-weight:700}
.tm-l2 b{color:var(--coral)}
.why{margin-top:70px;text-align:center}
.why .h2{margin:14px 0 10px}
.why-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:26px;margin-top:34px;text-align:left}
.why-card{transition:transform .25s ease-out;cursor:pointer;transform-style:preserve-3d;min-height:220px}
.why-card:nth-child(2){margin-top:44px}.why-card:nth-child(3){margin-top:88px}
.why-card .em{font-size:60px;display:block;margin-bottom:12px;transition:transform .3s var(--spring)}
.why-card:hover .em{transform:scale(1.2) rotate(-10deg)}
.why-card h3{font-size:24px;font-weight:800;margin-bottom:8px;line-height:1.1}
.why-card p{font-weight:600;font-size:17px}
.why-card .tap{position:absolute;right:14px;top:14px;font-size:12px;font-weight:800;border:2px solid var(--ink);border-radius:999px;padding:3px 9px;background:#fff}
.spring{animation:spring .7s var(--spring)}
@keyframes spring{0%{transform:scale(1)}30%{transform:scale(.9) rotate(-2deg)}60%{transform:scale(1.08) rotate(2deg)}100%{transform:scale(1)}}
.cta-wrap{display:flex;justify-content:center;margin:90px 0 20px}
.mega-btn{font-size:clamp(20px,3vw,32px);padding:24px 40px;border-radius:26px;background:var(--matcha);box-shadow:10px 10px 0 var(--ink);animation:bob 2s ease-in-out infinite}
.mega-btn:hover{animation:none;transform:translate(-4px,-4px) rotate(-2deg) scale(1.03);box-shadow:14px 14px 0 var(--ink)}

/* ================= QUIZ (shared) ================= */
.quiz{max-width:720px;margin:0 auto}
.q-start{text-align:center;padding:44px 26px;background:linear-gradient(160deg,var(--yellow),var(--pink))}
.q-start .big-emo{font-size:96px;display:block;animation:bob 2s ease-in-out infinite}
.q-start .h2{margin:12px 0 8px}
.q-start .lead{margin-bottom:26px}
.q-prog{height:18px;border:3px solid var(--ink);border-radius:999px;background:#fff;overflow:hidden;margin-bottom:18px;box-shadow:3px 3px 0 var(--ink)}
.q-prog span{display:block;height:100%;background:var(--matcha);transition:width .6s var(--spring);border-right:3px solid var(--ink)}
.q-card{min-height:250px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;overflow:hidden;background:var(--purple)}
.q-card.in{animation:fromR .55s var(--spring)}
.q-card.out{animation:outL .4s ease-in forwards}
@keyframes outL{to{opacity:0;transform:translateX(-90px) rotate(-6deg)}}
.q-num{font-weight:800;font-size:14px;background:#fff;border:2.5px solid var(--ink);border-radius:999px;padding:4px 12px;margin-bottom:10px}
.q-emo{font-size:64px;margin-bottom:8px}
.q-text{font-size:clamp(22px,3vw,30px);font-weight:800;line-height:1.15;max-width:560px}
.q-fb{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;padding:20px;font-weight:800;opacity:0;transform:scale(.6);transition:all .35s var(--spring);pointer-events:none}
.q-fb.on{opacity:1;transform:scale(1)}
.q-fb.ok{background:var(--matcha)}.q-fb.no{background:var(--coral);color:#fff}
.q-fb .t{font-size:clamp(30px,5vw,48px)}
.q-fb .w{font-size:17px;max-width:480px}
.q-btns{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:22px}
.q-btn{font-size:clamp(18px,2.6vw,24px);padding:22px 14px;border-radius:20px}
.q-btn.cap:hover{background:var(--coral);color:#fff}
.q-btn.fact:hover{background:var(--matcha)}
.q-btns.opts{grid-template-columns:1fr 1fr}
.q-btns.opts .btn{font-size:17px;padding:16px 14px;text-align:center}
.badge-end{text-align:center;padding:40px 20px}
.mega-badge{width:min(330px,72vw);aspect-ratio:1;margin:0 auto 24px;border-radius:50%;border:5px solid var(--ink);box-shadow:10px 10px 0 var(--ink);display:grid;place-items:center;position:relative;background:var(--yellow);animation:badgeIn 1s var(--spring)}
.mega-badge::before{content:"";position:absolute;inset:-34px;border-radius:50%;background:repeating-conic-gradient(var(--yellow) 0 10deg,transparent 10deg 20deg);z-index:-1;animation:spin 9s linear infinite;opacity:.9}
.mega-badge .be{font-size:clamp(90px,18vw,150px);animation:bob 2.2s ease-in-out infinite}
.mega-badge .ribbon{position:absolute;bottom:-18px;left:50%;transform:translateX(-50%) rotate(-3deg);background:var(--coral);color:#fff;border:3px solid var(--ink);border-radius:12px;padding:8px 18px;font-weight:800;white-space:nowrap;box-shadow:var(--sh-sm);font-size:18px}
@keyframes badgeIn{0%{transform:scale(0) rotate(-200deg)}100%{transform:scale(1) rotate(0)}}
@keyframes spin{to{transform:rotate(360deg)}}
.badge-end .h1{margin:30px 0 10px}
.score-pill{display:inline-block;font-size:22px;font-weight:800;background:#fff;border:3px solid var(--ink);border-radius:999px;padding:8px 22px;box-shadow:var(--sh-sm);margin:8px 0 24px}

/* ================= TAB 2 risk ================= */
.rp-opts{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:20px}
.rp-opt{padding:18px 16px;font-size:17px;text-align:left;justify-content:flex-start;min-height:72px}
.rp-opt:nth-child(1){background:var(--blue)}.rp-opt:nth-child(2){background:var(--mint)}.rp-opt:nth-child(3){background:var(--yellow)}.rp-opt:nth-child(4){background:var(--pink)}
.rp-opt .k{width:30px;height:30px;flex:none;border:2.5px solid var(--ink);border-radius:9px;background:#fff;display:grid;place-items:center;font-size:14px}
.rp-opt.picked{transform:scale(1.05) rotate(-1.5deg);box-shadow:8px 8px 0 var(--ink);background:var(--matcha)!important}
.rp-back{margin-top:16px;background:none;border:none;font-weight:800;text-decoration:underline;opacity:.7}
.ref{margin-top:30px;background:var(--cream);border:3px dashed var(--ink);border-radius:18px;padding:16px 18px;font-size:13.5px;font-weight:600}
.ref b{font-weight:800}
.ref li{margin:4px 0 0 18px}
.rp-hero{text-align:center;padding:40px 20px 34px;background:var(--tbg);overflow:hidden}
.rp-animal{font-size:clamp(110px,20vw,180px);line-height:1;animation:badgeIn 1s var(--spring),bob 2.4s 1s ease-in-out infinite;display:inline-block}
.rp-type{font-family:'Rubik Mono One';font-size:clamp(38px,8vw,84px);line-height:1;margin:10px 0 12px;-webkit-text-stroke:2px var(--ink);color:#fff;text-shadow:5px 5px 0 var(--ink);animation:fromR .7s .2s var(--spring) backwards}
.rp-nick{font-size:24px;font-weight:800;margin-top:12px}
.rp-line{font-size:19px;font-weight:700;max-width:560px;margin:10px auto 0}
.rp-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:22px;margin-top:26px}
.rp-grid .card{animation:fromR .6s var(--spring) backwards}
.rp-grid .card:nth-child(2){animation-delay:.1s}.rp-grid .card:nth-child(3){animation-delay:.2s}.rp-grid .card:nth-child(4){animation-delay:.3s}
.gauge{width:100%;max-width:300px;display:block;margin:8px auto 0}
